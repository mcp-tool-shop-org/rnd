{
  "cli": "claude",
  "cli_version": "2.1.197",
  "model": "claude-sonnet-5-5",
  "effort": "medium",
  "permission_mode": "default",
  "api_key_source": "none",
  "max_turns": 40,
  "output_format": "stream-json",
  "strict_mcp_config": true,
  "setting_sources": "local",
  "session_persistence": false,
  "builtin_tools": ["Read", "Grep", "Glob", "Bash"],
  "disable_slash_commands": true,
  "allowed_tools": [
    "Read(./**)",
    "Grep",
    "Glob",
    "Bash(git log:*)",
    "Bash(git show:*)"
  ],
  "disallowed_tools": [
    "Read(~/**)",
    "Read(//c/Users/**)",
    "Read(//d/**)",
    "Read(//e/AI/**)",
    "Read(//proc/**)",
    "Edit",
    "Write",
    "NotebookEdit",
    "WebFetch",
    "WebSearch",
    "Task"
  ],
  "atlas": {
    "package": "@dogfood-lab/atlas",
    "version": "1.26.0",
    "start": "node <tools>/node_modules/@dogfood-lab/atlas/cli.js mcp, from the run's checkout; installed once into <tools> before the pilot",
    "cache": "LOCALAPPDATA and XDG_CACHE_HOME set to <work>/runs/<run>.cache for the server alone, emptied before each attempt"
  },
  "arms": {
    "A": {
      "mcp_servers": {},
      "extra_allowed_tools": [],
      "prompt_note": "",
      "expected_mcp_tools": []
    },
    "B": {
      "mcp_servers": {
        "atlas": "the atlas start command above"
      },
      "extra_allowed_tools": ["mcp__atlas"],
      "prompt_note": "Answer with the atlas MCP tools: start with them, and read files only to confirm or fill in what they do not give you.",
      "expected_mcp_tools": [
        "mcp__atlas__atlas_changes",
        "mcp__atlas__atlas_check_change",
        "mcp__atlas__atlas_explain",
        "mcp__atlas__atlas_overview",
        "mcp__atlas__atlas_reach",
        "mcp__atlas__atlas_refresh",
        "mcp__atlas__atlas_test_gaps"
      ]
    }
  }
}
