#!/usr/bin/env sh
# rnd's pre-push hook: `rnd check` before every push. Where rnd-data-private is checked out beside the library, the
# check includes the exact private-file match (every hash in its manifest), which CI can't run. Install once per
# clone: git config core.hooksPath scripts/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
PY="${PYTHON:-python}"
if ! "$PY" -m rnd check; then
  echo "pre-push: rnd check failed; nothing was pushed (fix the files named above)" >&2
  exit 1
fi
