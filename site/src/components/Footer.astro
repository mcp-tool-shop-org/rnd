---
// Starlight's footer, plus a quiet follow line at the end of each newsletter issue, for a reader who arrived from
// a shared link and finished reading.
import Default from '@astrojs/starlight/components/Footer.astro';

const isIssue = /^newsletter\/issue-\d+$/.test(Astro.locals.starlightRoute.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  isIssue && (
    <p class="issue-follow">
      Follow each new issue: <a href={`${base}/newsletter/rss.xml`}>RSS</a>
    </p>
  )
}
<Default><slot /></Default>

<style>
  .issue-follow {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  /* The line sits outside .sl-markdown-content, so Starlight's prose link colour doesn't reach it. */
  .issue-follow a {
    color: var(--sl-color-text-accent);
  }
  .issue-follow a:hover {
    color: var(--sl-color-white);
  }
</style>
