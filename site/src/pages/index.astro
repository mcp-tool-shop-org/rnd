---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import BaseLayout from '@mcptoolshop/site-theme/components/BaseLayout.astro';
import Section from '@mcptoolshop/site-theme/components/Section.astro';
import CodeCardGrid from '@mcptoolshop/site-theme/components/CodeCardGrid.astro';
import { config } from '../site-config';

// The landing page: the weekly watch and the research briefs directory.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs');
const briefs = docs
  .filter((d) => d.id.startsWith('briefs/') && d.id !== 'briefs' && d.id !== 'briefs/index')
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? '') || a.data.title.localeCompare(b.data.title));
// The weekly watch: what changed in the tools and models we run, newest first.
const watches = docs
  .filter((d) => d.id.startsWith('watch/') && d.data.date)
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const watch = watches[0];
const pastWatches = watches.slice(1);
const useIt = config.sections.find((s) => s.id === 'use-it');
---

<BaseLayout
  title={config.title}
  description={config.description}
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  packageUrl={config.packageUrl}
  packageLabel={config.packageLabel}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={[
    { href: '#watch', label: 'The watch' },
    { href: '#briefs', label: 'Research briefs' },
    { href: '#use-it', label: 'Use it' },
  ]}
>
  <header class="pt-16">
    <p class="text-sm font-medium uppercase tracking-widest text-dim">The bench · studio research notes</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">
      What we measured, and what it means.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      The studio's research notes and briefs.
    </p>
  </header>

  <Section id="watch" title="The watch" subtitle="Every Monday: what changed in the tools and models the studio runs on, what it means for our work, and what we did about it.">
    {watch ? (
      <div class="mt-6 rounded-2xl border border-edge p-6">
        <p class="text-xs uppercase tracking-wider text-dim">{watch.data.date}</p>
        <h3 class="mt-1 text-lg font-semibold text-heading">{watch.data.title}</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-body">
          {(watch.data.highlights ?? []).map((h) => <li set:html={h} />)}
        </ul>
        <a href={`${base}/${watch.id}/`} class="mt-6 inline-flex rounded-xl border border-edge px-5 py-2.5 text-sm font-medium text-heading hover:bg-surface-raised/50">
          Read this week's watch
        </a>
        {pastWatches.length > 0 && (
          <p class="mt-4 text-sm text-muted">Earlier weeks: {pastWatches.map((w, i) => (
            <span>{i > 0 && ' · '}<a class="text-accent underline" href={`${base}/${w.id}/`}>{w.data.date}</a></span>
          ))}</p>
        )}
      </div>
    ) : (
      <p class="mt-6 text-muted">The first watch is in preparation.</p>
    )}
  </Section>

  <Section id="briefs" title="Research briefs" subtitle="One page per question: what we asked, what we found, the charts, the caveats and the receipts.">
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {briefs.map((b) => (
        <a href={`${base}/${b.id}/`} class="block min-w-0 rounded-2xl border border-edge p-5 hover:bg-surface-raised/50">
          <p class="text-xs uppercase tracking-wider text-dim">{b.data.status ?? ''}{b.data.date ? ` · ${b.data.date}` : ''}</p>
          <h3 class="mt-1 text-lg font-semibold text-heading">{b.data.title}</h3>
          <p class="mt-2 text-sm text-muted">{b.data.description}</p>
        </a>
      ))}
    </div>
  </Section>

  {useIt && useIt.kind === 'code-cards' && (
    <Section id="use-it" title="Use the bench" subtitle="The same findings, from the command line.">
      <CodeCardGrid cards={useIt.cards} />
    </Section>
  )}
</BaseLayout>
